{
  "$schema"  : "./node_modules/lintrix/schema/lintrix.config.schema.json",
  "extends"  : "lintrix:recommended",
  "project"  : "tsconfig.json",
  "rules": {
    "strict-boolean-expressions": "error",
    "no-floating-promises"      : "error",
    "eqeqeq"                    : "error",
    "curly"                     : ["error", "multi-line"],
    "prefer-const"              : "error"
  },
  "ignores"  : ["**/node_modules/**", "build/**"],
  "overrides": [
    {
      "files": ["tests/**"],
      "rules": {
        "no-floating-promises": "off"
      }
    }
  ],
  "//": "no-floating-promises is off in tests: node:test's describe()/it() return promises that the runner itself awaits."
}
